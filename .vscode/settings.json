{
  "editor.codeActionsOnSave": {
    // "source.fixAll.oxc": "explicit",
    "source.fixAll.sortJSON": "never"
  },
  "[toml]": {
    "editor.defaultFormatter": "Dylan23691.toml-analyzer"
  },
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "toml.formatter.alignEntries": true,
  "files.associations": {
    "**/dummy/mods/**/*.txt": "xml"
  },
  "files.exclude": {
    ".swc": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.swc/**": true,
    "**/node_modules/**": true,
    "**/target/**": true
  },
  "json.schemas": [
    {
      "fileMatch": [
        "/dummy/convert/input/*.json",
        "/dummy/behavior_gen/output/.d_merge/.debug/meshes/**/*.json"
      ],
      "url": "https://github.com/SARDONYX-sard/serde-hkx/raw/refs/tags/1.0.0/assets/serde_hkx_schema.json"
    }
  ],
  "rust-analyzer.cargo.targetDir": true,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.linkedProjects": ["Cargo.toml"],
  "rust-analyzer.runnables.extraTestBinaryArgs": [
    "--show-output",
    "--nocapture"
  ]
}
